{
  "openapi": "3.1.0",
  "info": {
    "title": "By Hamdi Public Services API",
    "version": "3.0.0",
    "description": "Public, read-only structured information about services offered by By Hamdi. Version 3.0.0 replaces the previous service endpoints with AI Sessions with Hamdi. The previous URLs redirect to the new endpoint."
  },
  "servers": [{ "url": "https://byhamdi.com", "description": "Production" }],
  "paths": {
    "/api/v1/services/ai-sessions": {
      "get": {
        "operationId": "getAiSessions",
        "summary": "Get AI Sessions with Hamdi details",
        "description": "Returns current public information about AI Sessions with Hamdi, including the session options and prices, the four-step process, the request form URL, and the canonical service URL. Customers submit a request before booking; Hamdi reviews each request and contacts the customer directly.",
        "responses": {
          "200": {
            "description": "Current AI Sessions with Hamdi details",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiSessionsService" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Provider": {
        "type": "object",
        "required": ["name", "brand", "website"],
        "properties": {
          "name": { "type": "string", "examples": ["Hamdi Mohamud Hassan"] },
          "brand": { "type": "string", "examples": ["By Hamdi"] },
          "website": { "type": "string", "format": "uri" }
        }
      },
      "AiSessionsService": {
        "type": "object",
        "required": ["id", "name", "provider", "headline", "description", "options", "note", "process", "request", "canonicalUrl"],
        "properties": {
          "id": { "type": "string", "const": "ai-sessions" },
          "name": { "type": "string", "examples": ["AI Sessions with Hamdi"] },
          "provider": { "$ref": "#/components/schemas/Provider" },
          "headline": { "type": "string" },
          "description": { "type": "string" },
          "options": {
            "type": "array",
            "description": "Available session options.",
            "items": {
              "type": "object",
              "required": ["id", "name", "price", "details"],
              "properties": {
                "id": { "type": "string", "examples": ["single-ai-session"] },
                "name": { "type": "string", "examples": ["Single AI Session"] },
                "price": {
                  "type": "object",
                  "required": ["amount", "currency"],
                  "properties": {
                    "amount": { "type": "number", "examples": [50] },
                    "currency": { "type": "string", "examples": ["USD"] }
                  }
                },
                "details": { "type": "array", "items": { "type": "string" } },
                "note": { "type": "string" }
              }
            }
          },
          "note": { "type": "string" },
          "process": {
            "type": "array",
            "description": "Ordered steps from request to independent practice.",
            "items": {
              "type": "object",
              "required": ["step", "name", "description"],
              "properties": {
                "step": { "type": "integer", "minimum": 1 },
                "name": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "request": {
            "type": "object",
            "required": ["url", "label", "note"],
            "properties": {
              "url": { "type": "string", "format": "uri", "description": "Request form. Customers submit a request before booking." },
              "label": { "type": "string" },
              "note": { "type": "string" }
            }
          },
          "canonicalUrl": { "type": "string", "format": "uri", "examples": ["https://byhamdi.com/ai-sessions"] }
        }
      }
    }
  }
}
